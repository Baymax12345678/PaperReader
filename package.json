{
  "name": "paper-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && tsc src/server/paperApi.ts --target ES2022 --module NodeNext --moduleResolution NodeNext --outDir dist-server --skipLibCheck",
    "electron:dev": "concurrently -k \"npm run dev -- --port 5173\" \"wait-on http://localhost:5173 && ELECTRON_RENDERER_URL=http://localhost:5173 electron .\"",
    "electron:pack": "npm run electron:app",
    "electron:app": "npm run build && node scripts/prepare-electron-app.mjs && node scripts/package-electron-app.mjs",
    "dist:mac": "npm run electron:app",
    "start": "node server.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "wait-on": "^9.0.10"
  }
}
